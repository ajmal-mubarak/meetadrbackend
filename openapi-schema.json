    PatchedFacilityDoctorRequest:
      type: object
      description: |-
        Facility-scoped doctor management serializer.

        Security & Domain Invariants:
        1. Facility assignment is strictly derived from the authenticated administrator.
        2. Client-supplied hospitalId, clinicId, or facilityId are strictly rejected/ignored.
        3. Reassignment across facilities is strictly forbidden.
        4. XOR invariant (Hospital XOR Clinic) is enforced server-side.
        5. Ratings, review counts, and status cannot be mass-assigned.
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 255
        name_ar:
          type: string
          maxLength: 255
        photo:
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        specialty:
          type: string
          minLength: 1
          maxLength: 128
        special_interests: {}
        experience_years:
          type: integer
        experience_text:
          type: string
          maxLength: 64
        experience_text_ar:
          type: string
          maxLength: 64
        education:
          type: string
          maxLength: 255
        consultation_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
          nullable: true
        location:
          type: string
          maxLength: 128
        about:
          type: string
        about_ar:
          type: string
        available_days:
          type: array
          items:
            type: string
            minLength: 1
          default:
          - Monday
          - Tuesday
          - Wednesday
          - Thursday
          - Saturday
        standard_slots:
          type: array
          items:
            type: string
            minLength: 1
          default:
          - 09:00 - 09:30
          - 09:30 - 10:00
          - 10:00 - 10:30
          - 11:00 - 11:30
          - 14:00 - 14:30
          - 15:00 - 15:30
        slot_duration_minutes:
          type: integer
          default: 30
