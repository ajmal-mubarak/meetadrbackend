openapi: 3.0.3
info:
  title: MeetAdr Healthcare API
  version: 1.0.0
  description: Enterprise healthcare appointment booking and provider discovery platform.
    Secured via short-lived JWT access tokens in the Authorization header (Bearer
    <access_token>) and rotation-tracked refresh tokens in HttpOnly cookies.
paths:
  /api/hospital-admin/appointments/{id}/cancel/:
    post:
      operationId: hospital_admin_appointments_cancel_create
      description: |-
        Facility administrator cancellation endpoint for doctors in their facility.
        POST /api/hospital-admin/appointments/{appointment_id}/cancel/
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Hospital Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/bookings/:
    get:
      operationId: v1_admin_bookings_list
      description: |-
        Platform administrator listing of all appointments platform-wide across Hospitals and Clinics.
        GET /api/v1/admin/bookings/
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAppointmentDetailList'
          description: ''
  /api/v1/admin/bookings/{id}/cancel/:
    post:
      operationId: v1_admin_bookings_cancel_create
      description: |-
        Platform administrator global appointment cancellation endpoint.
        POST /api/v1/admin/bookings/{id}/cancel/
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/dashboard/:
    get:
      operationId: v1_admin_dashboard_retrieve
      description: |-
        Platform administrator analytics & operational reporting.
        GET /api/v1/admin/reports/

        Security & Privacy Invariant:
        Platform-admin only. Never exposes individual patient PHI, clinical notes,
        diagnoses, or prescriptions. All metrics are aggregated.
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/doctors/:
    get:
      operationId: v1_admin_doctors_list
      description: |-
        Platform administrator listing of all registered Doctors across Hospitals and Clinics.
        GET /api/v1/admin/doctors/
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of results to return per page.
        schema:
          type: integer
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAdminDoctorListList'
          description: ''
  /api/v1/admin/doctors/{id}/status/:
    patch:
      operationId: v1_admin_doctors_status_partial_update
      description: |-
        Platform administrator doctor activation/deactivation endpoint.
        PATCH /api/v1/admin/doctors/{id}/status/
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/providers/:
    get:
      operationId: v1_admin_providers_retrieve
      description: |-
        Platform administrator listing of all registered Hospitals and Clinics.
        GET /api/v1/admin/providers/
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/providers/{id}/status/:
    patch:
      operationId: v1_admin_providers_status_partial_update
      description: |-
        Platform administrator global facility activation/deactivation endpoint.
        PATCH /api/v1/admin/providers/{id}/status/
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/reports/:
    get:
      operationId: v1_admin_reports_retrieve
      description: |-
        Platform administrator analytics & operational reporting.
        GET /api/v1/admin/reports/

        Security & Privacy Invariant:
        Platform-admin only. Never exposes individual patient PHI, clinical notes,
        diagnoses, or prescriptions. All metrics are aggregated.
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/requests/:
    get:
      operationId: v1_admin_requests_list
      description: |-
        Platform administrator listing of provider onboarding requests with faceted filtering.
        GET /api/v1/admin/requests/
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AdminProviderRequestList'
          description: ''
  /api/v1/admin/requests/{id}/:
    get:
      operationId: v1_admin_requests_retrieve
      description: |-
        Platform administrator single provider application inspection.
        GET /api/v1/admin/requests/{id}/
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AdminProviderRequestList'
          description: ''
  /api/v1/admin/requests/{id}/resend-invitation/:
    post:
      operationId: v1_admin_requests_resend_invitation_create
      description: |-
        Regenerates a fresh setup invitation token for an approved provider and
        returns the direct setup link so the admin can manually deliver it.

        POST /api/v1/admin/requests/{id}/resend-invitation/

        Security:
        - Platform admin only.
        - Only allowed for approved applications.
        - Invalidates the previous token and creates a new 72-hour one.
        - The raw token is returned ONCE in the response body (admin responsibility to deliver it).
        - The raw token is never persisted; only its SHA-256 hash is stored.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/requests/{id}/status/:
    patch:
      operationId: v1_admin_requests_status_partial_update
      description: |-
        Platform administrator application review and transition endpoint.
        PATCH /api/v1/admin/requests/{id}/status/

        Security & State Transition Invariants:
        1. Only platform administrators can review applications.
        2. Explicit transitions: pending -> approved, pending -> rejected.
        3. Re-approving an already approved application is strictly prevented (idempotent / conflict protection).
        4. Upon approval:
           - Creates Hospital XOR Clinic (strictly exclusive).
           - Facility initial status is set to 'Deactivated' per approved architecture.
           - Provisions facility admin account with role='hospital' and unusable password.
           - Generates single-use, 72-hour SHA-256 hashed setup token.
           - Dispatches invitation email with one-time setup link.
           - Records safe audit log without leaking tokens or credentials.
        5. Upon rejection:
           - Marks status as 'rejected'.
           - Does NOT create any facility or administrator account.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/appointments/:
    post:
      operationId: v1_appointments_create
      description: |-
        Authenticated patient consultation booking endpoint.
        Atomic concurrency-safe slot allocation preventing double-booking.
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/appointments/{id}/:
    get:
      operationId: v1_appointments_retrieve
      description: Retrieve details of a single appointment with object-level security.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/appointments/{id}/cancel/:
    post:
      operationId: v1_appointments_cancel_create
      description: |-
        Cancel an appointment.
        Authorized for owning Patient, attending Doctor, facility Administrator, or Platform Admin.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/appointments/{id}/complete/:
    post:
      operationId: v1_appointments_complete_create
      description: POST /api/v1/appointments/{id}/complete/ shortcut.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
    patch:
      operationId: v1_appointments_complete_partial_update
      description: Mark consultation completed, confirmed, or cancelled by attending
        doctor.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/appointments/{id}/facility-review/:
    get:
      operationId: v1_appointments_facility_review_retrieve
      description: |-
        Post-consultation verified facility (hospital or clinic) review endpoint.
        POST /api/v1/appointments/<uuid:pk>/facility-review/ (Patient creates review)
        GET /api/v1/appointments/<uuid:pk>/facility-review/ (Patient, Doctor, or Facility Admin reads review)
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
    post:
      operationId: v1_appointments_facility_review_create
      description: |-
        Post-consultation verified facility (hospital or clinic) review endpoint.
        POST /api/v1/appointments/<uuid:pk>/facility-review/ (Patient creates review)
        GET /api/v1/appointments/<uuid:pk>/facility-review/ (Patient, Doctor, or Facility Admin reads review)
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/appointments/{id}/reschedule/:
    post:
      operationId: v1_appointments_reschedule_create
      description: |-
        Reschedule an existing appointment to a new date and time slot.
        Authorized for owning Patient, attending Doctor, facility Administrator, or Platform Admin.
        Updates the existing appointment in place without creating a duplicate record.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/appointments/{id}/review/:
    get:
      operationId: v1_appointments_review_retrieve
      description: |-
        Post-consultation verified review endpoint.
        POST /api/v1/appointments/<uuid:pk>/review/ (Patient creates review)
        GET /api/v1/appointments/<uuid:pk>/review/ (Patient or attending Doctor reads review)
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
    post:
      operationId: v1_appointments_review_create
      description: |-
        Post-consultation verified review endpoint.
        POST /api/v1/appointments/<uuid:pk>/review/ (Patient creates review)
        GET /api/v1/appointments/<uuid:pk>/review/ (Patient or attending Doctor reads review)
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/appointments/my/:
    get:
      operationId: v1_appointments_my_list
      description: List appointments booked by the authenticated patient.
      tags:
      - Bookings
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AppointmentDetail'
          description: ''
  /api/v1/auth/login/:
    post:
      operationId: v1_auth_login_create
      description: Authenticates credentials, generates JWT tokens and sets HttpOnly
        cookie.
      tags:
      - Authentication
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserSummary'
          description: ''
  /api/v1/auth/logout/:
    post:
      operationId: v1_auth_logout_create
      description: Revokes refresh token, adds jti to blacklist, and clears HttpOnly
        cookie.
      tags:
      - Authentication
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/me/:
    get:
      operationId: v1_auth_me_retrieve
      description: Retrieves or updates authenticated user profile (/api/v1/auth/me/).
      tags:
      - Authentication
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
    patch:
      operationId: v1_auth_me_partial_update
      description: Retrieves or updates authenticated user profile (/api/v1/auth/me/).
      tags:
      - Authentication
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/auth/provider-setup/complete/:
    post:
      operationId: v1_auth_provider_setup_complete_create
      description: |-
        Public password establishment endpoint for newly approved facility administrators.
        POST /api/v1/auth/provider-setup/complete/
      tags:
      - Authentication
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/provider-setup/validate/:
    post:
      operationId: v1_auth_provider_setup_validate_create
      description: |-
        Public validation endpoint for single-use provider administrator invitation tokens.
        POST /api/v1/auth/provider-setup/validate/
      tags:
      - Authentication
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/auth/register/:
    post:
      operationId: v1_auth_register_create
      description: Public patient registration endpoint.
      tags:
      - Authentication
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatientRegisterRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatientRegisterRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatientRegisterRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserSummary'
          description: ''
  /api/v1/auth/token/refresh/:
    post:
      operationId: v1_auth_token_refresh_create
      description: Exchanges valid refresh token for rotated refresh token and new
        access token.
      tags:
      - Authentication
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CustomTokenRefreshRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CustomTokenRefreshRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CustomTokenRefreshRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CustomTokenRefresh'
          description: ''
  /api/v1/clinics/:
    get:
      operationId: v1_clinics_list
      description: |-
        Public directory of specialized outpatient clinics with faceted filtering.
        Filters: location, specialty, search keyword.
      tags:
      - Discovery & Facilities
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ClinicList'
          description: ''
  /api/v1/clinics/{id}/:
    get:
      operationId: v1_clinics_retrieve
      description: Detailed clinic profile with affiliated doctors roster.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Discovery & Facilities
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ClinicDetail'
          description: ''
  /api/v1/conditions/:
    get:
      operationId: v1_conditions_retrieve
      description: Public A-Z Health Conditions directory with symptoms and specialty
        mappings.
      tags:
      - Discovery & Facilities
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/conditions/{condition_id}/:
    get:
      operationId: v1_conditions_retrieve_2
      description: Detailed medical condition information by unique slug ID.
      parameters:
      - in: path
        name: condition_id
        schema:
          type: string
        required: true
      tags:
      - Discovery & Facilities
      security:
      - jwtAuth: []
      - BearerAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/doctor/{id}/:
    get:
      operationId: v1_doctor_retrieve
      description: |-
        Facility-scoped doctor inspection, updating, and de-registration.
        GET /api/v1/facility/doctors/{id}/
        PATCH /api/v1/facility/doctors/{id}/
        DELETE /api/v1/facility/doctors/{id}/

        Cross-Facility IDOR Protection:
        Attempting to access, modify, or delete a doctor belonging to another facility
        returns 404 Not Found to prevent resource enumeration and cross-facility leakage.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Doctor
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FacilityDoctor'
          description: ''
    put:
      operationId: v1_doctor_update
      description: |-
        Facility-scoped doctor inspection, updating, and de-registration.
        GET /api/v1/facility/doctors/{id}/
        PATCH /api/v1/facility/doctors/{id}/
        DELETE /api/v1/facility/doctors/{id}/

        Cross-Facility IDOR Protection:
        Attempting to access, modify, or delete a doctor belonging to another facility
        returns 404 Not Found to prevent resource enumeration and cross-facility leakage.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Doctor
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/FacilityDoctorRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/FacilityDoctorRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/FacilityDoctorRequest'
        required: true
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FacilityDoctor'
          description: ''
    patch:
      operationId: v1_doctor_partial_update
      description: |-
        Facility-scoped doctor inspection, updating, and de-registration.
        GET /api/v1/facility/doctors/{id}/
        PATCH /api/v1/facility/doctors/{id}/
        DELETE /api/v1/facility/doctors/{id}/

        Cross-Facility IDOR Protection:
        Attempting to access, modify, or delete a doctor belonging to another facility
        returns 404 Not Found to prevent resource enumeration and cross-facility leakage.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Doctor
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedFacilityDoctorRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedFacilityDoctorRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedFacilityDoctorRequest'
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FacilityDoctor'
          description: ''
    delete:
      operationId: v1_doctor_destroy
      description: |-
        Facility-scoped doctor inspection, updating, and de-registration.
        GET /api/v1/facility/doctors/{id}/
        PATCH /api/v1/facility/doctors/{id}/
        DELETE /api/v1/facility/doctors/{id}/

        Cross-Facility IDOR Protection:
        Attempting to access, modify, or delete a doctor belonging to another facility
        returns 404 Not Found to prevent resource enumeration and cross-facility leakage.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Doctor
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '204':
          description: No response body
  /api/v1/doctor/{id}/status/:
    patch:
      operationId: v1_doctor_status_partial_update
      description: |-
        Facility administrator doctor status toggling (Active / Deactivated).
        PATCH /api/v1/facility/doctors/{id}/status/

        Cross-Facility IDOR Protection:
        Attempting to toggle status for a doctor from another facility returns 404 Not Found.
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Doctor
      security:
      - jwtAuth: []
      - BearerAuth: []
      responses:
        '200':
          description: No response body
