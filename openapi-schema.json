    PatientRegisterRequest:
      type: object
      description: |-
        Public patient registration serializer.
        Strictly hardcodes role='patient', is_staff=False, is_superuser=False.
        Any submitted privileged keys are discarded.
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 255
        email:
          type: string
          format: email
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 1
        phone:
          type: string
          default: ''
          maxLength: 32
      required:
      - email
      - name
      - password
    ProviderRequestPublicCreate:
      type: object
      description: |-
        Public submission serializer for hospital and clinic partnership requests.

        Security & Domain Invariants:
        - Only 'hospital' and 'clinic' provider types are permitted.
        - Individual doctor registration through this flow is strictly rejected.
        - Status is strictly enforced to 'pending' by the server.
        - All administrative review fields are read-only.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        provider_type:
          $ref: '#/components/schemas/ProviderTypeEnum'
        name:
          type: string
          maxLength: 255
          minLength: 2
        name_ar:
          type: string
          default: ''
          maxLength: 255
        contact_person:
          type: string
          maxLength: 255
          minLength: 2
        contact_number:
          type: string
          maxLength: 32
          minLength: 6
        email:
          type: string
          format: email
        country:
          type: string
          default: United Arab Emirates
          maxLength: 64
        location:
          type: string
          maxLength: 128
          minLength: 2
        address:
          type: string
          default: ''
        status:
          allOf:
          - $ref: '#/components/schemas/StatusEf1Enum'
          readOnly: true
        admin_notes:
          type: string
          default: ''
        submitted_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - contact_number
      - contact_person
      - email
      - id
      - location
      - name
      - provider_type
      - status
      - submitted_at
    ProviderRequestPublicCreateRequest:
      type: object
      description: |-
        Public submission serializer for hospital and clinic partnership requests.

        Security & Domain Invariants:
        - Only 'hospital' and 'clinic' provider types are permitted.
        - Individual doctor registration through this flow is strictly rejected.
        - Status is strictly enforced to 'pending' by the server.
        - All administrative review fields are read-only.
      properties:
        provider_type:
          $ref: '#/components/schemas/ProviderTypeEnum'
        name:
          type: string
          minLength: 2
          maxLength: 255
        name_ar:
          type: string
          default: ''
          maxLength: 255
        contact_person:
          type: string
          minLength: 2
          maxLength: 255
        contact_number:
          type: string
          minLength: 6
          maxLength: 32
        email:
          type: string
          format: email
          minLength: 1
        country:
          type: string
          minLength: 1
          default: United Arab Emirates
          maxLength: 64
        location:
          type: string
          minLength: 2
          maxLength: 128
        address:
          type: string
          default: ''
        admin_notes:
          type: string
          default: ''
      required:
      - contact_number
      - contact_person
      - email
      - location
      - name
      - provider_type
    ProviderRequestPublicStatus:
      type: object
      description: |-
        Public, privacy-preserving serializer for querying application status by reference ID.

        Privacy Invariants:
        - Exposes strictly non-sensitive status and timestamp information.
        - Sensitive fields (applicant email, phone, contact person, address, license,
          admin notes, review actor, and internal facility details) are strictly excluded.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        provider_type:
          allOf:
          - $ref: '#/components/schemas/ProviderTypeEnum'
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/StatusEf1Enum'
          readOnly: true
        submitted_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - id
      - provider_type
      - status
      - submitted_at
    ProviderTypeEnum:
      enum:
      - hospital
      - clinic
      type: string
      description: |-
        * `hospital` - Hospital
        * `clinic` - Clinic
    RelationEnum:
      enum:
      - Spouse
      - Child
      - Parent
      - Sibling
      - Other
      type: string
      description: |-
        * `Spouse` - Spouse
        * `Child` - Child
        * `Parent` - Parent
        * `Sibling` - Sibling
        * `Other` - Other
    RoleEnum:
      enum:
      - patient
      - doctor
      - hospital
      - admin
      type: string
      description: |-
        * `patient` - Patient
        * `doctor` - Doctor
        * `hospital` - Hospital/Clinic Administrator
        * `admin` - Platform Superadministrator
    Status57cEnum:
      enum:
      - Active
      - Deactivated
      type: string
      description: |-
        * `Active` - Active
        * `Deactivated` - Deactivated
    StatusEf1Enum:
      enum:
      - pending
      - approved
      - rejected
      type: string
      description: |-
        * `pending` - Pending Review
        * `approved` - Approved
        * `rejected` - Rejected
    UserSummary:
      type: object
      description: Safe, minimal summary of authenticated user profile.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        email:
          type: string
          format: email
          readOnly: true
        name:
          type: string
          maxLength: 255
        phone:
          type: string
          maxLength: 32
        role:
          allOf:
          - $ref: '#/components/schemas/RoleEnum'
          readOnly: true
        avatar:
          nullable: true
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        doctor_id:
          type: string
          readOnly: true
        facility_id:
          type: string
          readOnly: true
        facility_type:
          type: string
          readOnly: true
        facility_name:
          type: string
          readOnly: true
        date_joined:
          type: string
          format: date-time
          readOnly: true
      required:
      - date_joined
      - doctor_id
      - email
      - facility_id
      - facility_name
      - facility_type
      - id
      - name
      - role
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: Enter JWT Bearer token obtained from /api/v1/auth/login/
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
