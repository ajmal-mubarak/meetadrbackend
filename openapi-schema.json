components:
  schemas:
    AdminDoctorList:
      type: object
      description: |-
        Platform-wide admin serializer for Doctor management.
        Provides camelCase aliases for the AdminDoctors frontend contract while preserving
        snake_case attributes and relational facility details.
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        name:
          type: string
          maxLength: 255
        name_ar:
          type: string
          maxLength: 255
        photo:
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        specialty:
          type: string
          maxLength: 128
        special_interests: {}
        experience_years:
          type: integer
        experience_text:
          type: string
          maxLength: 64
        experience_text_ar:
          type: string
          maxLength: 64
        rating:
          type: string
          format: decimal
          pattern: ^-?\d{0,1}(?:\.\d{0,2})?$
        review_count:
          type: integer
        location:
          type: string
          maxLength: 128
        consultation_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
          nullable: true
        status:
          $ref: '#/components/schemas/Status57cEnum'
        hospital_id:
          type: string
          readOnly: true
        hospital_name:
          type: string
          readOnly: true
        hospital_name_ar:
          type: string
          readOnly: true
        clinic_id:
          type: string
          readOnly: true
        clinic_name:
          type: string
          readOnly: true
        about:
          type: string
        about_ar:
          type: string
        education:
          type: string
          maxLength: 255
        available_days:
          type: string
          readOnly: true
        available_slots:
          type: string
          readOnly: true
        experience:
          type: string
          readOnly: true
        hospitalName:
