        experience_text:
          type: string
          maxLength: 64
        experience_text_ar:
          type: string
          maxLength: 64
        education:
          type: string
          maxLength: 255
        consultation_fee:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
          nullable: true
