# ==============================================================================
# MeetAdr Backend Environment Variables Template
# Copy this file to .env and configure for your environment.
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-replace-with-secure-random-key
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# --- Database Configuration ---
# Option 1: Supabase IPv4 Pooler (Session Mode port 5432)
# Replace <project-ref>, <db-password> (percent-encode special characters like @ to %40), and <region>
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Option 2: Individual PostgreSQL parameters
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=your-db-password
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432

# Option 3: Local SQLite (comment out DATABASE_URL and DB_ENGINE above to default to db.sqlite3)

# --- Frontend Integration ---
FRONTEND_URL=http://localhost:3000

# --- JWT Token Lifetime (Optional Overrides) ---
# ACCESS_TOKEN_LIFETIME_MINUTES=60
# REFRESH_TOKEN_LIFETIME_DAYS=7
